# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# Clave de sesión de Flask. Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL (la usa Docker Compose al crear la base)
POSTGRES_PASSWORD=

# Conexiones para ejecutar el Studio y las pruebas fuera de Docker (repite la contraseña)
DATABASE_URL=postgresql+psycopg://studio:CONTRASEÑA@localhost:5432/studio
TEST_DATABASE_URL=postgresql+psycopg://studio:CONTRASEÑA@localhost:5432/studio_test
REDIS_URL=redis://localhost:6379/0

# Cookies solo por HTTPS. Usa false únicamente en desarrollo con `flask run` (http).
SESSION_COOKIE_SECURE=false
